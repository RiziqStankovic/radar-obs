# Shared local Collector settings. Copy to .env in the repository root.
# Do not commit .env or real credentials.

RADAR_LOG_LEVEL=info

# Agent: OTLP input and forwarding to the separately deployed gateway.
RADAR_AGENT_HEALTH_ENDPOINT=127.0.0.1:13133
RADAR_AGENT_TELEMETRY_ENDPOINT=127.0.0.1:8889
RADAR_AGENT_OTLP_GRPC_ENDPOINT=127.0.0.1:4317
RADAR_AGENT_OTLP_HTTP_ENDPOINT=127.0.0.1:4318
RADAR_GATEWAY_OTLP_ENDPOINT=http://127.0.0.1:4319
RADAR_HOST_METRICS_INTERVAL=30s
# RADAR_HOST_ROOT_PATH is intentionally omitted on Windows; hostmetrics root_path is Linux-only.

# Gateway: separate OTLP input and health endpoint.
RADAR_GATEWAY_HEALTH_ENDPOINT=127.0.0.1:13134
RADAR_GATEWAY_TELEMETRY_ENDPOINT=127.0.0.1:8890
RADAR_GATEWAY_OTLP_GRPC_ENDPOINT=127.0.0.1:4320
RADAR_GATEWAY_OTLP_HTTP_ENDPOINT=127.0.0.1:4319

# ClickHouse native protocol: do not use HTTP 8123 here.
# One exporter instance maps to one database; never join database names.
RADAR_CLICKHOUSE_ENDPOINT=tcp://127.0.0.1:9000
RADAR_CLICKHOUSE_USER=default
RADAR_CLICKHOUSE_PASSWORD=
RADAR_CLICKHOUSE_LOGS_DATABASE=radar_logs
RADAR_CLICKHOUSE_TRACES_DATABASE=radar_traces
RADAR_CLICKHOUSE_METRICS_DATABASE=radar_metrics
